# SSH credentials — the server reads them from <project-root>/.env
# (PARENT_DIR = the parent of mcps/, see mcp_server_netmiko.py:62).
# Copy to .env and fill in. NEVER commit the .env.

NETMIKO_USERNAME=your-username
NETMIKO_PASSWORD=your-password
NETMIKO_SECRET=

# Only when Fedele (SoT) is the inventory or the credential source:
# FEDELE_URL=https://fedele.example.com/api
# FEDELE_TOKEN=
# FEDELE_CREDENTIALS_KEY=
